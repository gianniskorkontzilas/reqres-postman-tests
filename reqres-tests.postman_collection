				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const userID = pm.environment.get(\"UserID\");\r",
							"\r",
							"\r",
							"pm.test(\"Correct User Fetched\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.id).to.eql(userID);\r",
							"});\r",
							"\r",
							"pm.test(\"Data object has required fields\", function () {\r",
							"    const data = pm.response.json().data;\r",
							"    pm.expect(data).to.have.property(\"id\");\r",
							"    pm.expect(data).to.have.property(\"email\");\r",
							"    pm.expect(data).to.have.property(\"first_name\");\r",
							"    pm.expect(data).to.have.property(\"last_name\");\r",
							"    pm.expect(data).to.have.property(\"avatar\");\r",
							"});\r",
							"\r",
							"pm.test(\"Email is in valid email format\", function () {\r",
							"    const data = pm.response.json().data;\r",
							"    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r",
							"    pm.expect(data.email).to.match(emailRegex);\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type header is application/json\", function () {\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
							"});"
